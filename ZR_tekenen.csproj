<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ZR_tekenen</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>ZR Tekenen</ApplicationTitle>
    <ApplicationId>com.zaydrazan.zrtekenen</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>30.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <MauiXaml Update="**/*.xaml" Generator="MSBuild:Compile" />
  </ItemGroup>
</Project>
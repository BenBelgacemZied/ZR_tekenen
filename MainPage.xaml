<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZR_tekenen.MainPage"
             Title="ZR Tekenen"
             BackgroundColor="#EAF4FF">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">
            <Label Text="✈️ Op Reis met Zayd en Razan"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#16325C"
                   HorizontalTextAlignment="Center" />

            <Label Text="🇧🇪 Brussel  •  🇫🇷 Frankrijk"
                   FontSize="20"
                   HorizontalTextAlignment="Center" />

            <Border BackgroundColor="White" Stroke="#B5CBE8" StrokeThickness="2" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="🎨 ZR Tekenen – testversie"
                           FontSize="22"
                           FontAttributes="Bold" />
                    <Label Text="Deze versie is extra eenvoudig gemaakt zodat we eerst controleren dat de app goed opent op jouw Android-toestel."
                           FontSize="16" />
                </VerticalStackLayout>
            </Border>

            <Button Text="🏠 Teken een huis"
                    Clicked="OnHouseClicked"
                    BackgroundColor="#2F80ED"
                    TextColor="White" />

            <Button Text="🗼 Frankrijk"
                    Clicked="OnFranceClicked"
                    BackgroundColor="#FFFFFF"
                    TextColor="#16325C" />

            <Button Text="⚛️ Brussel"
                    Clicked="OnBrusselsClicked"
                    BackgroundColor="#FFFFFF"
                    TextColor="#16325C" />

            <Border x:Name="ResultCard"
                    IsVisible="False"
                    BackgroundColor="#FFF8D8"
                    Stroke="#F3D36A"
                    StrokeThickness="2"
                    Padding="18">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="ResultTitle"
                           Text="Goed gedaan!"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="ResultText"
                           Text="une maison"
                           FontSize="26"
                           TextColor="#2F80ED"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="⭐ +3 sterren"
                           FontSize="18"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Privé test – versie 0.2"
                   FontSize="12"
                   TextColor="#6B7A90"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>